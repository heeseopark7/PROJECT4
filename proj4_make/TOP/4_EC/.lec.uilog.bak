   global cmd_ret_string
   set pos [.a.pane.f3.command.text.text index insert]
  set row [lindex [split $pos .] 0]
  set last_pos [.a.pane.f3.command.text.text index end]
  set last_row [lindex [split $last_pos .] 0]  
  if {$row != [expr $last_row -1]} {
     return
  }
  set _last_pos {end - 1 chars}
  catch { set sel_string [selection get] }
  if {[info exist sel_string] == 0} { return }
  if {$sel_string == ""} { return }
  #.a.pane.f3.command.text.text mark set insert $_last_pos
  set pos [.a.pane.f3.command.text.text index insert]
  set row [lindex [split $pos .] 0]
  set column [lindex [split $pos .] 1]
  set com_string [.a.pane.f3.command.text.text get $row.1 $row.end]
  set cmd_ret_string ""        
  callback Gui_select_command $row $column $com_string $sel_string
  if {$cmd_ret_string != ""} {
    $guiMainCmdW insert $pos $cmd_ret_string
  }
  .a.pane.f3.command.text.text mark set insert $row.[expr $column + [string length $sel_string]]
  .a.pane.f3.command.text.text see insert
  focus .a.pane.f3.command.text.text
